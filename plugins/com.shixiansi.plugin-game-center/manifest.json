{
  "id": "com.shixiansi.plugin-game-center",
  "name": "游戏中心（接金币）",
  "version": "0.1.0",
  "author": "shixiansi",
  "description": "宠物旁的轻量小游戏「接金币」：左右移动篮子接住掉落的金币与道具（磁铁、双倍、护盾），躲开炸弹。有开始菜单、实时计分板与结束结算面板；本局得分经 plugin.share 发给桌宠生态（亲密度/金币由记忆侧消费），游戏结束按胜负触发桌宠的欢呼或失落状态。逻辑引擎不依赖 DOM，面板只做渲染。",
  "permissions": [
    "plugin.share",
    "pet.surface",
    "storage",
    "plugin.config"
  ],
  "surface": [
    {
      "dx": 160,
      "dy": -160,
      "w": 380,
      "h": 300,
      "maxH": 560,
      "radius": 14
    }
  ],
  "shareRead": [],
  "config": [
    {
      "key": "shareScore",
      "label": "把每局得分发布到共享牌盘（桌宠生态的亲密度/金币由那边消费）",
      "type": "bool",
      "default": "true"
    },
    {
      "key": "coinValue",
      "label": "每枚金币价值（积分，会累计成发布给生态的金币）",
      "type": "number",
      "default": "10"
    },
    {
      "key": "bombPenalty",
      "label": "吃到炸弹扣多少分（0=不扣，只结束）",
      "type": "number",
      "default": "30"
    },
    {
      "key": "highScores",
      "label": "本地最高分留几条",
      "type": "number",
      "default": "5"
    }
  ],
  "entry": "panel.html",
  "assets": [
    "lib/core.js",
    "lib/engine.js",
    "lib/workshop.js"
  ]
}
