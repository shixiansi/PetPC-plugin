{
  "id": "com.shixiansi.plugin-desktop-wallpaper",
  "name": "壁纸联动（环境色合成）",
  "version": "0.1.1",
  "author": "shixiansi",
  "description": "每天抓一次 Bing 每日壁纸，用 k-means 提取主色调、三次盒滤波生成毛玻璃底色，经 plugin.share 把环境快照（主色、渐变、mood）发布给桌宠：桌宠据此调整光影与主题色。面板里看色板、模糊预览与最近 30 天的历史；其他插件可以 plugin.call 问当前环境或触发重抓。",
  "permissions": [
    "net.fetch",
    "storage",
    "plugin.config",
    "plugin.share",
    "plugin.call",
    "pet.bubble"
  ],
  "serves": ["ambient_now", "refresh", "history"],
  "background": true,
  "netHosts": ["www.bing.com", "cn.bing.com"],
  "config": [
    {
      "key": "bingHost",
      "label": "Bing 源（国际版或国内版；两个域都在白名单里）",
      "type": "select",
      "default": "www.bing.com",
      "options": [
        { "value": "www.bing.com", "label": "国际版 www.bing.com" },
        { "value": "cn.bing.com", "label": "国内版 cn.bing.com" }
      ]
    },
    {
      "key": "autoFetch",
      "label": "每天上午自动抓一次（关掉后只能在面板里手动抓）",
      "type": "bool",
      "default": "true"
    },
    {
      "key": "bubbleOnUpdate",
      "label": "换壁纸后桌宠说一句（需要 pet.bubble）",
      "type": "bool",
      "default": "true"
    }
  ],
  "entry": "panel.html",
  "assets": [
    "lib/pixels.js",
    "lib/bing.js",
    "lib/apply.js",
    "lib/decode.js",
    "lib/workshop.js",
    "ui.css"
  ]
}
