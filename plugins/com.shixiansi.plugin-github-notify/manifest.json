{
  "id": "com.shixiansi.plugin-github-notify",
  "name": "GitHub 通知",
  "version": "0.1.0",
  "author": "shixiansi",
  "description": "盯住几个 GitHub 仓库的 PR / Issue / CI：有新动静就让桌宠说一句摘要（一句里带仓库名与事件类型，不是一串标题），宠物头顶的徽标挂着未读数；插件页里是完整的事件列表与轮询设置。按事件 id 去重——同一个事件只提醒一次；内容没变（304）就一句都不说。token 过期、被限流、仓库不存在各有各的中文说法，全部落在界面上而不是只写进 console。数据来自 api.github.com 的仓库事件接口。",
  "permissions": [
    "net.fetch",
    "storage",
    "plugin.config",
    "pet.surface",
    "pet.bubble"
  ],
  "netHosts": [
    "api.github.com"
  ],
  "panel": true,
  "background": true,
  "config": [
    {
      "key": "token",
      "label": "Personal Access Token（只读就够；为什么这一项是明文，见 README）",
      "type": "text",
      "default": ""
    },
    {
      "key": "repos",
      "label": "仓库列表（owner/repo，逗号分隔，最多 8 个）",
      "type": "text",
      "default": ""
    },
    {
      "key": "intervalMinutes",
      "label": "每隔几分钟抓一次（最少 5）",
      "type": "number",
      "default": "10"
    },
    {
      "key": "kinds",
      "label": "只通知这几类",
      "type": "select",
      "multiple": true,
      "default": "pr,issue,ci",
      "options": [
        { "value": "pr", "label": "PR（新开、重开、可合并、关闭）" },
        { "value": "issue", "label": "Issue（新开、重开、关闭）" },
        { "value": "ci", "label": "CI（Actions / 检查跑完）" }
      ]
    }
  ],
  "entry": "panel.html",
  "assets": [
    "lib/core.js",
    "lib/github.js",
    "lib/state.js",
    "lib/notify.js",
    "lib/workshop.js",
    "ui.css"
  ]
}
