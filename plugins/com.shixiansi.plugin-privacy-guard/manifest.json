{
  "id": "com.shixiansi.plugin-privacy-guard",
  "name": "隐私卫士（敏感信息监控与脱敏）",
  "version": "0.1.1",
  "author": "shixiansi",
  "description": "盯着剪贴板和你的 .env/.txt 文件：身份证（带校验位）、手机号、银行卡（Luhn 校验）、sk- 开头的 API Key、邮箱、内网 IP 一出现就自动脱敏，桌宠弹窗提醒（同类告警 10 分钟节流）。扫描全在本机完成；告警只发布规则名与风险级别，不含原文。其他插件发文本前可以 plugin.call 让它先扫一遍。",
  "permissions": [
    "process",
    "storage",
    "plugin.config",
    "plugin.share",
    "plugin.call",
    "pet.bubble"
  ],
  "serves": ["scan", "alerts", "rules"],
  "background": true,
  "config": [
    {
      "key": "helperPath",
      "label": "PowerShell 路径（powershell.exe 的绝对路径；留空=不启动自动监控，试验台仍可用）",
      "type": "text",
      "default": ""
    },
    {
      "key": "helperScript",
      "label": "辅助脚本路径（安装目录里 privacy-guard-helper.ps1 的绝对路径）",
      "type": "text",
      "default": ""
    },
    {
      "key": "watchDir",
      "label": "要盯的目录（绝对路径；留空=用户主目录的顶层，不递归）",
      "type": "text",
      "default": ""
    },
    {
      "key": "alertCooldownMin",
      "label": "同类告警的最小间隔（分钟，1–60；默认 10）",
      "type": "number",
      "default": "10"
    },
    {
      "key": "rule_openai_key",
      "label": "识别：API Key（sk- 开头）",
      "type": "bool",
      "default": "true"
    },
    {
      "key": "rule_bearer_token",
      "label": "识别：Bearer 令牌",
      "type": "bool",
      "default": "true"
    },
    {
      "key": "rule_id_card",
      "label": "识别：身份证号（含校验位验证）",
      "type": "bool",
      "default": "true"
    },
    {
      "key": "rule_phone",
      "label": "识别：手机号",
      "type": "bool",
      "default": "true"
    },
    {
      "key": "rule_bank_card",
      "label": "识别：银行卡号（含 Luhn 校验）",
      "type": "bool",
      "default": "true"
    },
    {
      "key": "rule_email",
      "label": "识别：邮箱地址",
      "type": "bool",
      "default": "true"
    },
    {
      "key": "rule_ipv4",
      "label": "识别：IP 地址",
      "type": "bool",
      "default": "true"
    }
  ],
  "entry": "panel.html",
  "assets": [
    "lib/patterns.js",
    "lib/watch.js",
    "lib/workshop.js",
    "privacy-guard-helper.ps1",
    "ui.css"
  ]
}
