{
  "id": "com.shixiansi.plugin-web-scraper",
  "name": "网页提取（正文评分转 Markdown）",
  "version": "0.1.0",
  "author": "shixiansi",
  "description": "输入一个网址：按段落密度、链接占比与类名关键词给页面上的容器评分，挑出真正的正文，去掉导航栏与广告，转成整洁的 Markdown 存进本地文章库。其他插件可以用 plugin.call 让它抓页面或读文章；抓完桌宠会弹一句。",
  "permissions": [
    "net.fetch",
    "storage",
    "plugin.config",
    "plugin.call",
    "pet.bubble"
  ],
  "serves": ["scrape_one", "library_list", "library_get", "library_latest"],
  "callTargets": [
    "com.shixiansi.plugin-memcore/chat"
  ],
  "background": true,
  "netHosts": ["example.com", "www.example.com"],
  "config": [
    {
      "key": "extraHosts",
      "label": "抓取白名单（逗号分隔的域名，会合并进网络白名单；也可以在面板里按行填）",
      "type": "text",
      "default": "",
      "hostWhitelist": true
    },
    {
      "key": "bubbleAfterScrape",
      "label": "抓取完成后桌宠弹一句（需要 pet.bubble）",
      "type": "bool",
      "default": "true"
    }
  ],
  "entry": "panel.html",
  "assets": [
    "lib/turndown.js",
    "lib/extract.js",
    "lib/tomd.js",
    "lib/library.js",
    "lib/scrape.js",
    "lib/workshop.js",
    "ui.css"
  ]
}
