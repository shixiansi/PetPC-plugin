{
  "id": "com.shixiansi.plugin-memcore",
  "name": "记忆核心（人设 + 分层记忆）",
  "version": "0.2.0",
  "author": "shixiansi",
  "description": "人设与记忆只在这里存一份：接入端插件（QQ、OneBot 等）把它收到的每句话用 plugin.call 交给这里，这里拼好上下文、问模型、把这一轮记下来再把回答交回去。装了联网搜索插件后，记忆答不上的问题它会先上网查资料再回答（auto / always / off 三档可调）。",
  "permissions": ["plugin.call", "llm.chat", "llm.borrow", "storage", "plugin.config"],
  "callTargets": ["com.shixiansi.plugin-websearch/search"],
  "serves": ["chat", "seed"],
  "background": true,
  "config": [
    {
      "key": "personaName",
      "label": "角色名（回答里用它自称；也是记忆按角色分开的键之一）",
      "type": "text",
      "default": "小记"
    },
    {
      "key": "persona",
      "label": "人设（L0，每一轮都整段注入；留空=默认那个话不多但记得住事的搭子）",
      "type": "text",
      "default": ""
    },
    {
      "key": "replyMaxChars",
      "label": "回复字数上限（群里三句话比一段话好读；也压低一次调用占用这 30 秒的风险）",
      "type": "number",
      "default": "240"
    },
    {
      "key": "bufferTurns",
      "label": "每个会话最近记住几轮往来（L1 滚动缓冲；超过就压成摘要）",
      "type": "number",
      "default": "8"
    },
    {
      "key": "summaryChars",
      "label": "会话摘要最多多少字（L2）",
      "type": "number",
      "default": "500"
    },
    {
      "key": "episodeMax",
      "label": "每个会话最多留几条长期记忆（L3，满了丢最旧的）",
      "type": "number",
      "default": "40"
    },
    {
      "key": "profileEvery",
      "label": "每攒够几次摘要，就把它们合成一份用户画像（L4；0=不做画像）",
      "type": "number",
      "default": "3"
    },
    {
      "key": "webSearch",
      "label": "联网搜索（需要安装并启用「联网搜索」插件）：auto=记忆答不上才查；always=每轮都查；off=不上网",
      "type": "select",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "自动（记忆答不上时才查）" },
        { "value": "always", "label": "每轮都先查再答" },
        { "value": "off", "label": "关闭（纯记忆）" }
      ]
    },
    {
      "key": "webSearchCount",
      "label": "联网搜索每次取几条结果（1–10，越多占的上下文越多）",
      "type": "number",
      "default": "5"
    },
    {
      "key": "llmBaseUrl",
      "label": "接口地址（留空=借用对话插件的配置）",
      "type": "text",
      "default": ""
    },
    {
      "key": "llmModel",
      "label": "模型（留空=借用对话插件的配置）",
      "type": "text",
      "default": ""
    },
    {
      "key": "llmApiKey",
      "label": "API Key（留空=借用对话插件的配置；密钥只在宿主里，本插件读不到明文）",
      "type": "secret",
      "secret": true
    },
    {
      "key": "llmDailyBudget",
      "label": "每日请求上限（次，0=不限；摘要与画像也会花掉几次）",
      "type": "number",
      "default": "200"
    }
  ],
  "entry": "panel.html",
  "assets": [
    "lib/core.js",
    "lib/memory.js",
    "lib/prompt.js",
    "lib/websearch.js",
    "lib/chat.js",
    "lib/workshop.js",
    "ui.css"
  ]
}
