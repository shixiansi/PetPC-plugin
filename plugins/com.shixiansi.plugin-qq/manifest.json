{
  "id": "com.shixiansi.plugin-qq",
  "name": "QQ 群聊插件",
  "version": "1.16.1",
  "author": "shixiansi",
  "description": "把大模型接进 QQ 群：用 Milky 协议端（Yogurt 等）的长连接接收群消息，被 @ 时借用对话插件的模型配置回答。它会记群里的要点和群友、有高低的社交能量、会自己挑表情包并收藏群里的新图。",
  "permissions": ["net.ws", "net.fetch", "llm.chat", "llm.borrow", "storage", "plugin.config", "events", "process", "plugin.share", "plugin.call"],
  "background": true,
  "shareRead": ["com.shixiansi.plugin-bilibili/bili-results", "com.shixiansi.plugin-bilibili/recommend"],
  "callTargets": ["com.shixiansi.plugin-memcore/chat", "com.shixiansi.plugin-memcore/seed", "com.shixiansi.plugin-diange/song", "com.shixiansi.plugin-diange/song_link"],
  "netHosts": ["127.0.0.1:3000", "gchat.qpic.cn", "multimedia.nt.qq.com.cn"],
  "config": [
    { "key": "server", "label": "Milky 协议端地址（host:port，或 http://host:port/前缀）", "type": "text", "default": "127.0.0.1:3000", "hostWhitelist": true },
    { "key": "accessToken", "label": "访问令牌（协议端没设 token 就留空）", "type": "text", "default": "" },
    { "key": "atOnly", "label": "只回应 @ 机器人", "type": "bool", "default": "true" },
    { "key": "replyChance", "label": "非 @ 消息的插话概率（0=不插话，100=每条都回；需关闭上一项）", "type": "number", "default": "0" },
    { "key": "proactiveMinutes", "label": "主动开口：平均每隔多少分钟说一句（0=关闭）", "type": "number", "default": "0" },
    { "key": "batchEnabled", "label": "自己看聊天决定要不要插一句（攒批：一批消息最多一次请求）", "type": "bool", "default": "true" },
    { "key": "batchWindowSec", "label": "攒批间隔（秒，两次评估之间至少隔这么久；越小越像活人、越费 token）", "type": "number", "default": "120" },
    { "key": "batchMaxPerHour", "label": "每群每小时最多评估几次（硬上限；0=不去看聊天）", "type": "number", "default": "8" },
    { "key": "prefix", "label": "前缀触发（留空=关闭，例如 #问）", "type": "text", "default": "" },
    { "key": "groupAllow", "label": "只在这些群生效（群号，逗号分隔；留空=所有群）", "type": "text", "default": "" },
    { "key": "persona", "label": "群里的人格设定（留空=默认像个群里的老熟人；写了就整段替换那行默认）", "type": "text", "default": "" },
    { "key": "contextTurns", "label": "每群记住几条往来", "type": "number", "default": "8" },
    { "key": "memoryNotesMax", "label": "每群长期记忆条数上限（模型自己记的要点，0=不记）", "type": "number", "default": "20" },
    { "key": "energyBaseline", "label": "社交能量基线 0-100（越低越懒、越少主动搭话）", "type": "number", "default": "70" },
    { "key": "replyMaxChars", "label": "回复字数上限", "type": "number", "default": "300" },
    { "key": "cooldownSec", "label": "同一群最小间隔（秒）", "type": "number", "default": "5" },
    { "key": "quoteChance", "label": "回复时引用提问那条消息的概率（0-100；0=从不引用，100=每条都引用）", "type": "number", "default": "60" },
    { "key": "visionModel", "label": "看图模型（留空=不读图，只把平台给的图片摘要放进提示词）", "type": "text", "default": "" },
    { "key": "visionMaxImages", "label": "一条消息最多读几张图", "type": "number", "default": "2" },
    { "key": "visionPrompt", "label": "看图的附加指令（可留空）", "type": "text", "default": "" },
    { "key": "stickerUrls", "label": "表情包图库（每行一个 http(s) 图片地址，留空=不发表情）", "type": "text", "default": "" },
    { "key": "ownerQQ", "label": "主人 QQ（只有 TA 私聊发合并转发时才会导入表情包）", "type": "text", "default": "" },
    { "key": "stickerChance", "label": "回完一句话后随机再贴一张表情的概率（0-100；0=从不贴，100=每次都想贴，仍受下面冷却限制；模型点名要发的那张不受此限制）", "type": "number", "default": "30" },
    { "key": "stickerCooldownSec", "label": "同一群两次表情的最小间隔（秒）", "type": "number", "default": "120" },
    { "key": "pokeBackChance", "label": "被戳一戳时戳回去的概率（0-100；剩下的概率是回一句话；协议端不支持戳人时自动改成回话）", "type": "number", "default": "40" },
    { "key": "autoCollectStickers", "label": "自动收群里的新图进图库（每张要一次识图，每群每小时最多 3 张）", "type": "bool", "default": "true" },
    { "key": "llmProvider", "label": "服务商预设（留空=借用对话插件的配置）", "type": "text", "default": "" },
    { "key": "llmBaseUrl", "label": "接口地址（留空=借用对话插件的配置）", "type": "text", "default": "" },
    { "key": "llmModel", "label": "模型（留空=借用对话插件的配置）", "type": "text", "default": "" },
    { "key": "llmApiKey", "label": "API Key（留空=借用对话插件的配置）", "type": "secret", "secret": true },
    { "key": "llmDailyBudget", "label": "每日请求上限（次，0=不限；导入一大批表情包会吃掉很多次）", "type": "number", "default": "300" },
    { "key": "clientPath", "label": "协议端可执行文件路径（.exe，留空=不代管）", "type": "text", "default": "" },
    { "key": "clientArgs", "label": "启动参数（空格分隔，可留空）", "type": "text", "default": "" },
    { "key": "autoStartClient", "label": "自动启动协议端客户端", "type": "bool", "default": "false" },
    { "key": "biliLinkReply", "label": "群里出现 B 站链接时自动发视频", "type": "bool", "default": "false" },
    { "key": "biliLinkAtOwner", "label": "发视频 / 推荐时 @ 主人（用下面的「主人 QQ」）", "type": "bool", "default": "true" },
    { "key": "biliMaxMB", "label": "视频体积上限（MB，超过就只发链接）", "type": "number", "default": "80" },
    { "key": "biliMaxMinutes", "label": "视频时长上限（分钟，超过就只发链接）", "type": "number", "default": "25" },
    { "key": "biliRecommendGroup", "label": "B 站刷到值得看的时发到这个群（群号，留空=不推）", "type": "text", "default": "" },
    { "key": "ffmpegPath", "label": "ffmpeg.exe 的绝对路径（留空=不发视频，只发链接）", "type": "text", "default": "" }
  ],
  "entry": "panel.html",
  "assets": [
    "lib/core.js",
    "lib/store.js",
    "lib/media.js",
    "lib/state.js",
    "lib/inbound.js",
    "lib/importer.js",
    "lib/protocol.js",
    "lib/reminders.js",
    "lib/memory.js",
    "lib/proactive.js",
    "lib/bili.js",
    "lib/admin.js",
    "lib/workshop.js",
    "lib/stickers.js",
    "lib/memcore.js",
    "lib/reply_gate.js",
    "lib/reply_splitter.js",
    "lib/song.js"
  ]
}
