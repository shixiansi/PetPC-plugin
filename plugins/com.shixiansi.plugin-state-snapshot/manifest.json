{
  "id": "com.shixiansi.plugin-state-snapshot",
  "name": "状态时光机（记忆快照）",
  "version": "1.0.1",
  "author": "shixiansi",
  "description": "给桌宠的记忆装一个游戏存档：调用记忆核心把当前的分层记忆（L1 往来、L2 摘要、L3 情节与长期摘要、全局事件链）整库打包成 JSON，保存在自己的快照库里；可以命名、列表、删除，随时回滚到任何一个历史快照——回滚是整库替换，恢复之后记忆就是那一刻的样子，没有脏数据。插件页以时间线展示全部快照并带恢复按钮。",
  "permissions": [
    "storage",
    "plugin.config",
    "plugin.call",
    "plugin.share",
    "pet.bubble"
  ],
  "callTargets": [
    "com.shixiansi.plugin-memcore/export-state",
    "com.shixiansi.plugin-memcore/import-state"
  ],
  "config": [
    { "key": "maxSnapshots", "label": "最多保留几个快照（满了丢最旧的）", "type": "number", "default": "20" },
    { "key": "confirmRollback", "label": "回滚前要求按一次确认（打开=更安全）", "type": "bool", "default": "true" },
    { "key": "bubbleOnRollback", "label": "回滚完成后让桌宠弹一句气泡", "type": "bool", "default": "true" }
  ],
  "panel": true,
  "entry": "panel.html",
  "assets": [
    "lib/core.js",
    "lib/store.js",
    "lib/snapshots.js",
    "lib/workshop.js",
    "ui.css"
  ]
}
